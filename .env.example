# Fish Audio TTS
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free

# 세션 서명
SESSION_SECRET=

# 렌더 워커
WORKER_TOKEN=
APP_URL=http://localhost:3000
WHISPER_MODEL=ggml-base.bin
# CLIPART_PRESET_DIR: 운영자 기본 캐릭터 **그림 파일**이 든 디렉터리
#   (기본 ~/.codex/skills/character-clipart-library). 워커에서만 쓴다 — 앱은 이 값을 보지
#   않는다. 어떤 캐릭터가 있는지(카탈로그)는 저장소에 커밋된
#   data/preset-clipart-catalog.json에서 앱·워커가 함께 읽는다. 캐릭터를 추가한 뒤에는
#   npm run sync:preset-catalog 를 돌리고 그 파일을 커밋한다.
#   기본 경로를 쓸 때는 아래를 비운 채로 두지 말고 주석으로 둔다 — 빈 문자열도 "설정됨"이라
#   `presetDir()`이 기본값으로 되돌아가지 않는다.
# CLIPART_PRESET_DIR=

# 저장소
# STORE_DIR: 로컬 JSON 저장 경로(기본 .local-data)
STORE_DIR=
# BLOB_READ_WRITE_TOKEN: 설정하면 JSON·완성 MP4 모두 Vercel Blob으로 간다
BLOB_READ_WRITE_TOKEN=

# 수강생 초대코드 발급:
#   npx tsx scripts/seed-student.ts "<이름>"

