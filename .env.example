# Fish Audio TTS
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free

# 세션 서명
SESSION_SECRET=

# 렌더 워커
WORKER_TOKEN=
APP_URL=http://localhost:3000
WHISPER_MODEL=ggml-base.bin

# 저장소
# STORE_DIR: 로컬 JSON 저장 경로(기본 .local-data)
STORE_DIR=
# BLOB_READ_WRITE_TOKEN: 설정하면 JSON·완성 MP4 모두 Vercel Blob으로 간다
BLOB_READ_WRITE_TOKEN=

# 수강생 초대코드 발급:
#   npx tsx scripts/seed-student.ts "<이름>"

